---
import ContactPanel from '@components/ContactPanel.astro';
import Container from '@components/Container.astro';
import FitCardGrid from '@components/FitCardGrid.astro';
import SocialIcon from '@components/SocialIcon.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { site, suitableInquiryAreas } from '@lib/site';
---

<PageLayout
  eyebrow="Kontak"
  title="Hubungi Saya"
  description="Apabila Mau Kerjasama Bisa Hubungi Kontak berikut ini."
  tags={['Rollen', 'Projekte', 'Cloud', 'Automation']}
>
  <section class="section section-after-header">
    <Container class="grid gap-6 md:grid-cols-[1.12fr_0.88fr]">
      <ContactPanel />
      <div class="surface-card">
        <h2 class="text-2xl font-semibold text-[color:var(--ink)]">Profile</h2>
        <div class="mt-5 grid gap-3">
          <a class="button-secondary justify-start gap-2" href={site.social.linkedin} target="_blank" rel="noopener noreferrer">
            <SocialIcon name="linkedin" />
            LinkedIn
          </a>
          <a class="button-secondary justify-start gap-2" href={site.social.xing} target="_blank" rel="noopener noreferrer">
            <SocialIcon name="xing" />
            Xing
          </a>
          <a class="button-secondary justify-start gap-2" href={site.social.github} target="_blank" rel="noopener noreferrer">
            <SocialIcon name="github" />
            GitHub
          </a>
        </div>
      </div>
      <div class="md:col-span-2">
        <p class="meta-label">Rollen & Projekte</p>
        <h2 class="mt-2 text-2xl font-semibold text-[color:var(--ink)]">Passende Anfragen</h2>
        <p class="mt-3 max-w-3xl leading-7 text-[color:var(--muted)]">
          Passend sind Rollen und Projekte, in denen technische Abläufe zuverlässiger, nachvollziehbarer und stärker
          automatisiert werden sollen — von Cloud-Infrastruktur über Deployment-Workflows bis zu ITSM- und
          Netzwerkprozessen.
        </p>
        <FitCardGrid items={suitableInquiryAreas} class="mt-6" />
      </div>
      <div class="surface-card md:col-span-2 sm:p-8">
        <h2 class="text-2xl font-semibold text-[color:var(--ink)]">Bitte mitsenden</h2>
        <p class="mt-3 leading-7 text-[color:var(--muted)]">
          Für eine schnelle Einschätzung sind Rollenbeschreibung, Tech Stack, Vertragsart, Remote-/Hybrid-Regelung,
          Standort, Startzeitpunkt und Gehalts- oder Budgetrahmen hilfreich. Rollenbeschreibung, Lebenslauf oder
          ähnliche Unterlagen können Sie direkt im Kontaktformular als Datei anhängen.
        </p>
      </div>
    </Container>
  </section>
</PageLayout>
