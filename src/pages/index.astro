---
import BlogCard from '@components/BlogCard.astro';
import ContactPanel from '@components/ContactPanel.astro';
import Container from '@components/Container.astro';
import FitCardGrid from '@components/FitCardGrid.astro';
import Hero from '@components/Hero.astro';
import ProjectCard from '@components/ProjectCard.astro';
import SkillCluster from '@components/SkillCluster.astro';
import TimelineItem from '@components/TimelineItem.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { byExperienceDateDesc, byProjectTitleForLocale, byPubDateDesc } from '@lib/content';
import { site, skillClusters, suitableInquiryAreas } from '@lib/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.locale === 'id' && project.data.featured)
  .sort(byProjectTitleForLocale('id'));
const posts = (await getCollection('blog'))
  .filter((post) => post.data.locale === 'id' && !post.data.draft)
  .sort(byPubDateDesc)
  .slice(0, 3);
const experience = (await getCollection('experience'))
  .filter((item) => item.data.locale === 'id')
  .sort(byExperienceDateDesc)
  .slice(0, 2);
---

<BaseLayout title={site.title} description={site.description}>
  <Hero />

  <section class="section section-soft">
    <Container>
      <div class="max-w-3xl">
        <p class="eyebrow">Profile</p>
        <h2 class="section-title">Peran Antar Muka Yang Sangatlah Cocok Bagi Pemula.</h2>
        <p class="section-copy">
          Saya sangat cocok untuk peran-peran di mana infrastruktur, implementasi, dan proses teknis perlu dibuat lebih andal, mudah dilacak, dan sangat otomatis.
</p>
      </div>

      <FitCardGrid items={suitableInquiryAreas} class="mt-10" />
    </Container>
  </section>

  <section class="section section-dark">
    <Container class="grid gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
      <div>
        <p class="eyebrow text-[color:var(--gold)]">Area Teknis</p>
        <h2 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">
          Infrastruktur cloud, otomatisasi penerapan, dan operasi dipertimbangkan secara bersamaan.
        </h2>
        <p class="mt-5 max-w-xl leading-8 text-[color:var(--warm-muted)]">
          Pekerjaan saya menggabungkan infrastruktur berbasis AWS, CI/CD, Kubernetes, alur kerja ITSM, otomatisasi jaringan, dan proses rekayasa yang didukung AI. Intinya: membuat sistem lebih mudah dipahami, andal, dan lebih mudah diotomatisasi.
</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {skillClusters.map((cluster) => <SkillCluster {...cluster} dark />)}
      </div>
    </Container>
  </section>

  <section class="section section-tight-bottom">
    <Container>
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Project Saya</p>
          <h2 class="section-title">Beberapa Projek Web Yang saya Lakukan.</h2>
          <p class="section-copy">
            Berikut ini adalah Projek Webdev yang bisa kalian lihat di bawah ini, dan apabila ingin kerjasama bisa langsung hubungi kontak di bawah ya!.
          </p>
        </div>
        <a class="button-secondary self-start md:self-auto" href="/projects/">Lihat Projek</a>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Container>
  </section>

  <section class="section section-tight-y">
    <Container>
      <p class="eyebrow">Pengalaman Kerja</p>
      <h2 class="section-title">Pengalaman Kerja di Beberapa Perusahaan.</h2>
      <p class="section-copy">
        Berikut Ini adalah Pengalaman Kerja Yang Pernah saya lakukan hingga saat ini:
      
      </p>

      <ol class="timeline-list mt-10 max-w-4xl" aria-label="Pengalaman Kerja">
        {experience.map((item) => <li><TimelineItem item={item} /></li>)}
      </ol>

      <div class="mt-5 pl-8 sm:pl-10">
        <a class="button-secondary" href="/cv/">Lihat CV Offline</a>
      </div>
    </Container>
  </section>

  <section class="section section-tight-top">
    <Container>
      <ContactPanel />
    </Container>
  </section>

  {posts.length > 0 && (
    <section class="section section-soft">
      <Container>
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="eyebrow">Blog</p>
            <h2 class="section-title">Note Sudar Blogger.</h2>
            <p class="section-copy">
              Berbagi Pengalaman Ngeblog dan Esai yang di tulis di blog ini, Supaya bisa menjadi inspirasi semua yang membaca nya. 
            </p>
          </div>
          <a class="button-secondary self-start md:self-auto" href="/blog/">Zum Blog</a>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {posts.map((post) => <BlogCard post={post} />)}
        </div>
      </Container>
    </section>
  )}
</BaseLayout>
